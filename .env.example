# -----------------------------------------------------------------------------
#  Modèle de configuration — COPIER ce fichier en « .env » et adapter.
#  Le .env n'est JAMAIS versionné : il contient des secrets.
# -----------------------------------------------------------------------------

# Connexion PostgreSQL (valeurs du docker-compose fourni).
# Pilote pg8000 : écrit en Python pur, aucune bibliothèque native à charger.
DATABASE_URL=postgresql+pg8000://r5a5:r5a5@localhost:5432/tournois

# Clé de signature des jetons JWT — 32 caractères minimum. En générer une :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=a-remplacer-par-une-cle-generee

# Origines autorisées à appeler l'API et le WebSocket, séparées par des virgules.
# 5173 est le port du serveur de développement du front.
CORS_ORIGINS=http://localhost:5173

# Durée de validité d'un jeton, en minutes (contrat d'API §2.1 : 12 heures).
JWT_EXPIRATION_MINUTES=720

# Journalisation : niveau (DEBUG, INFO, WARNING, ERROR) et format (json, texte).
LOG_LEVEL=INFO
LOG_FORMAT=texte

# Port d'écoute de l'API
PORT=5000
