# -----------------------------------------------------------------------------
#  Modèle de configuration — COPIER ce fichier en « .env » et adapter.
#  Le .env n'est JAMAIS versionné : il contient des secrets.
# -----------------------------------------------------------------------------

# Connexion PostgreSQL (valeurs du docker-compose fourni).
# Identifiants de la base Docker locale : sans valeur hors de votre machine.
# Pilote pg8000 : écrit en Python pur, aucune bibliothèque native à charger.
DATABASE_URL=postgresql+pg8000://r5a5:r5a5@localhost:5432/tournois

# Clé de signature des jetons JWT — 32 caractères minimum, sinon l'API refuse de démarrer
# (la valeur du modèle ci-dessous est refusée aussi). En générer une :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=a-remplacer-par-une-cle-generee

# Origines autorisées à appeler l'API et le WebSocket, séparées par des virgules.
# 5173 est le port du serveur de développement du front.
CORS_ORIGINS=http://localhost:5173

# Durée de validité d'un jeton, en minutes (contrat d'API §2.1 : 12 heures).
JWT_EXPIRATION_MINUTES=720

# Cookie de session envoyé seulement en HTTPS. « false » en développement (HTTP).
COOKIE_SECURE=false

# Tentatives de connexion et d'inscription autorisées par adresse.
LIMITE_CONNEXION=5 per minute
LIMITE_INSCRIPTION=10 per hour

# Mode debug de Flask : « true » en développement uniquement.
FLASK_DEBUG=true

# Journalisation : niveau (DEBUG, INFO, WARNING, ERROR) et format (json, texte).
LOG_LEVEL=INFO
LOG_FORMAT=texte

# Adresse et port d'écoute de l'API. 127.0.0.1 : cette machine seulement ;
# 0.0.0.0 ouvre l'API au réseau (conteneur Docker, démonstration en salle).
HOTE=127.0.0.1
PORT=5000

# --- Réglages facultatifs (valeurs par défaut entre parenthèses) --------------
# Messages de chat par utilisateur (30 per minute).
# LIMITE_MESSAGES=30 per minute

# Temps réel : ping toutes les 20 s, pong attendu sous 15 s, 4096 octets par message,
# 30 événements par 10 s et par connexion, jetons expirés vérifiés toutes les 30 s.
# SOCKET_PING_INTERVALLE_SECONDES=20
# SOCKET_PING_DELAI_SECONDES=15
# SOCKET_TAILLE_MAX_OCTETS=4096
# SOCKET_EVENEMENTS_MAX=30
# SOCKET_FENETRE_DEBIT_SECONDES=10
# SOCKET_CONNEXIONS_MAX_PAR_ADRESSE=20
# SOCKET_VERIFICATION_SECONDES=30

# Nombre de reverse proxys devant l'API (0 en développement, 1 derrière Nginx).
# Sans cela, le limiteur de débit voit l'adresse du proxy pour tous les clients.
# PROXIES_DE_CONFIANCE=0
